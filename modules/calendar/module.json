{
  "id": "calendar",
  "name": "Calendar",
  "version": "1.24.45",
  "icon": "calendar-days",
  "color": "red",
  "description": "Sessions and events for the whole {environment} and for each {space}, with reminders.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "destination": [
      { "id": "calendar", "part": "main", "entry": "page.html" },
      { "id": "calendar", "part": "panel", "entry": "page.html", "label": "Agenda", "order": 10 }
    ],
    "page": {
      "entry": "page.html"
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 400,
      "height": 580,
      "mode": [
        "dock",
        "float"
      ],
      "lobby": true
    },
    "widget": {
      "entry": "widget.html",
      "title": "Coming up",
      "size": "tall",
      "order": 10
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See the calendar",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add and change events",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "labels": { "event": { "one": "event", "many": "events" } },
  "settings": [
    {
      "key": "defaultView",
      "template": "default",
      "label": "Open on",
      "type": "choice",
      "scope": "person",
      "default": "month",
      "help": "The view the Calendar shows when you open it.",
      "options": [
        {
          "value": "month",
          "label": "Month"
        },
        {
          "value": "week",
          "label": "Week"
        },
        {
          "value": "day",
          "label": "Day"
        },
        {
          "value": "list",
          "label": "Agenda"
        }
      ]
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "hooks": {
    "schedule": true,
    "notify": true,
    "external": true
  },
  "events": {
    "publishes": [
      {
        "name": "ended",
        "kind": "event",
        "label": "An event has passed",
        "data": {
          "summary": "string"
        }
      }
    ]
  },
  "actions": {
    "provides": [
      {
        "name": "createEvent",
        "label": "Add it to the calendar",
        "description": "Add an event to the calendar.",
        "inputHints": {
          "title": "The event's name.",
          "date": "The first day, as YYYY-MM-DD, for example 2026-11-20.",
          "time": "Start time as HH:MM, 24-hour, for example 10:00. Leave it out for an all-day event.",
          "endTime": "End time as HH:MM, on the same day or on endDate; it needs a start time.",
          "endDate": "Last day of a multi-day event, as YYYY-MM-DD.",
          "allDay": "True for an all-day event; do not send it with a time.",
          "repeat": "One of: day, week, 2weeks, month, year.",
          "remind": "Minutes before the start to remind people: 0, 15, 60 or 1440."
        },
        "effect": "write",
        "input": {
          "title": "string",
          "date": "date?",
          "ref": "ref?",
          "object": "object?",
          "time": "string?",
          "endTime": "string?",
          "endDate": "date?",
          "allDay": "boolean?",
          "repeat": "string?",
          "remind": "number?"
        },
        "needs": ["date"],
        "takes": [
          { "kinds": ["event", "*", "text"], "except": ["flight", "train", "bus", "ferry", "car", "hotel", "restaurant", "cafe", "bar", "sight", "museum", "attraction", "tour", "show"], "as": "an event" }
        ]
      },
      {
        "name": "addEvent",
        "label": "Add an event",
        "local": true,
        "input": {
          "text": "string"
        }
      }
    ],
    "uses": [
      "*"
    ]
  },
  "commands": [
    { "name": "e", "word": "event", "label": "Add an event", "action": "addEvent", "hint": "the event" }
  ],
  "refs": {
    "produces": [
      {
        "kind": "event",
        "name": "Event",
        "open": true,
        "backlinks": true,
        "key": "event:{id}",
        "summary": {
          "title": "title",
          "subtitle": "desc",
          "when": "start",
          "end": "end",
          "allDay": "allDay"
        },
        "dated": { "title": "title", "start": "start", "end": "end", "allDay": "allDay", "tz": "tz", "repeat": "repeat", "skips": "skips" },
        "feed": true,
        "mirror": "in",
        "create": { "id": "{id}", "desc": "", "remind": null, "repeat": null, "by": "{by}" }
      }
    ],
    "consumes": [
      "*"
    ]
  }
}
