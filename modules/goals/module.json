{
  "id": "goals",
  "name": "Planner - Goals",
  "version": "0.1.8",
  "icon": "bullseye",
  "color": "green",
  "description": "Plan goals together: each goal with its steps and how far along it is, dates optional.",
  "author": "Coffee Pub",
  "scope": [
    "environment",
    "space"
  ],
  "surfaces": {
    "page": {
      "entry": "page.html"
    },
    "canvas": {
      "entry": "canvas.html",
      "width": 440,
      "height": 600,
      "mode": [
        "dock",
        "float"
      ]
    }
  },
  "permissions": [
    {
      "key": "view",
      "label": "See the goals",
      "default": {
        "member": true,
        "guest": true,
        "moderator": true
      }
    },
    {
      "key": "edit",
      "label": "Add and change goals",
      "default": {
        "member": true,
        "guest": false,
        "moderator": true
      }
    },
    {
      "key": "clear",
      "label": "Clear all goals",
      "default": {
        "member": false,
        "guest": false,
        "moderator": true
      }
    }
  ],
  "access": {
    "read": "view",
    "write": "edit"
  },
  "guards": {
    "clear": "clear"
  },
  "actions": {
    "provides": [
      {
        "name": "addGoal",
        "label": "Add it as a goal",
        "description": "Add a new goal to the plan.",
        "effect": "write",
        "inputHints": {
          "owners": "Who owns it: keys or names as list_members shows them, separated by commas.",
          "date": "The target day, as YYYY-MM-DD.",
          "object": "A full description to add instead of the flat fields; its own words, day and phase are used.",
          "why": "Why it matters. Line breaks are allowed."
        },
        "input": {
          "title": "string",
          "why": "text?",
          "date": "date?",
          "owners": "text?",
          "object": "object?"
        },
        "takes": [
          { "kinds": ["goal"], "as": "a goal" }
        ]
      },
      {
        "name": "addStep",
        "label": "Add a step to the goal",
        "description": "Add a new step under a goal of the plan.",
        "effect": "write",
        "inputHints": {
          "goal": "The goal it goes under, as a pointer; needed unless the description names the goal.",
          "date": "The day, as YYYY-MM-DD.",
          "object": "A full description to add instead of the flat fields; details.under names the goal by title."
        },
        "input": {
          "goal": "ref:goals:plan?",
          "title": "string",
          "date": "date?",
          "object": "object?"
        },
        "takes": [
          { "kinds": ["step"], "as": "a step" }
        ]
      },
      {
        "name": "addNote",
        "label": "Add it as a note to the plan",
        "description": "Add a note to the plan, under a goal if one is given.",
        "effect": "write",
        "inputHints": {
          "goal": "The goal to put it under, as a pointer; leave it out for a note on the plan itself.",
          "object": "A full description to add instead of the flat fields; its own words are used.",
          "text": "The text. Line breaks are allowed."
        },
        "input": {
          "title": "string",
          "text": "text?",
          "goal": "ref:goals:plan?",
          "object": "object?"
        },
        "takes": [
          { "kinds": ["note"], "as": "a note" }
        ]
      }
    ]
  },
  "refs": {
    "produces": [
      {
        "kind": "plan",
        "name": "{name}",
        "open": true,
        "backlinks": true,
        "key": "plan:{id}",
        "dated": {
          "title": "title",
          "day": "shownDate"
        },
        "mirror": "out",
        "categoryNames": {
          "goal": "Goal",
          "step": "Step",
          "note": "Note"
        },
        "summary": {
          "title": "title",
          "subtitle": "why",
          "when": "shownDate",
          "done": "done",
          "phase": "phase",
          "progress": "progress",
          "category": "kind",
          "text": "text"
        }
      }
    ],
    "consumes": [
      "*"
    ]
  },
  "labels": {
    "goal": { "one": "goal", "many": "goals", "a": "a goal" },
    "step": { "one": "step", "many": "steps", "a": "a step" },
    "note": { "one": "note", "many": "notes", "a": "a note" },
    "owner": { "one": "owner", "many": "owners", "a": "an owner" }
  },
  "starter": true,
  "settings": [
    {
      "key": "dates",
      "template": "driven",
      "label": "Dates",
      "type": "choice",
      "scope": "space",
      "default": "optional",
      "help": "Whether goals and steps show a date at all. Dates are never required.",
      "options": [
        { "value": "optional", "label": "Optional" },
        { "value": "off", "label": "Off" }
      ]
    },
    {
      "key": "progressBy",
      "template": "driven",
      "label": "A goal's progress",
      "type": "choice",
      "scope": "space",
      "default": "steps",
      "help": "Steps: a goal is as far along as its steps that are done, and done when they all are. Done: a goal is ticked done or not.",
      "options": [
        { "value": "steps", "label": "Its steps" },
        { "value": "done", "label": "Done or not" }
      ]
    },
    {
      "key": "defaultView",
      "template": "default",
      "label": "Open on",
      "type": "choice",
      "scope": "person",
      "default": "goals",
      "help": "The view you see first when you open the plan.",
      "options": [
        { "value": "goals", "label": "Goals" },
        { "value": "list", "label": "List" }
      ]
    }
  ]
}
