        "title": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "amount": {
          "type": [
            "number",
            "null"
          ]
        },
        "planned": {
          "type": [
            "number",
            "null"
          ]
        },
        "actual": {
          "type": [
            "number",
            "null"
          ]
        },
        "category": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "payer": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "sharedBy": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1,
          "maxLength": 200
        },
        "date": {
          "type": [
            "string",
            "null"
          ],
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "description": "A date, YYYY-MM-DD."
